rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User on-chain mining profile state
    match /users/{walletAddress} {
      allow read: if true;
      allow create, update: if request.resource.data.walletAddress is string
        && request.resource.data.totalPoints is number
        && request.resource.data.currentTier is number;
    }

    // Transaction settlement records
    match /transactions/{txId} {
      allow read: if true;
      allow create: if request.resource.data.amountUSD is number
        && request.resource.data.type is string
        && request.resource.data.userAddress is string;
    }

    // Referral Activity & Speed Boost Event Logs
    match /referralEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.referrerAddress is string
        && request.resource.data.refereeAddress is string
        && request.resource.data.type is string;
    }
  }
}
