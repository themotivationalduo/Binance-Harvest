{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "On-chain Web3 user mining profile, tier progress, and verification status",
      "type": "object",
      "properties": {
        "walletAddress": { "type": "string" },
        "currentTier": { "type": "number" },
        "miningBalance": { "type": "number", "description": "BHFT token mining balance stored as float/string representation" },
        "totalPoints": { "type": "number" },
        "miningBalanceBNB": { "type": "number" },
        "lastClaimDate": { "type": "string" },
        "minerStartTimestamp": { "type": "string" },
        "withdrawalStatus": { "type": "string" },
        "treasuryWalletAddress": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "loginStreak": { "type": "number" },
        "lastStreakClaimDate": { "type": "string" },
        "totalStreakPointsClaimed": { "type": "number" },
        "createdAt": { "type": "string" },
        "lastActiveTimestamp": { "type": "string" },
        "referredBy": { "type": "string" },
        "referralCount": { "type": "number" },
        "referredUsers": { "type": "array", "items": { "type": "string" } },
        "referralBonusPercent": { "type": "number" }
      },
      "required": ["walletAddress", "currentTier", "totalPoints"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "On-chain tier upgrade or withdrawal fee transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userAddress": { "type": "string" },
        "type": { "type": "string" },
        "amountBNB": { "type": "number" },
        "amountUSD": { "type": "number" },
        "txHash": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userAddress", "amountUSD", "type", "txHash"]
    },
    "UsedTxHash": {
      "title": "UsedTxHash",
      "description": "Processed on-chain transaction hashes preventing replay attacks across all payments",
      "type": "object",
      "properties": {
        "txHash": { "type": "string" },
        "walletAddress": { "type": "string" },
        "type": { "type": "string" },
        "amountBNB": { "type": "number" },
        "amountUSD": { "type": "number" },
        "blockNumber": { "type": "number" },
        "confirmations": { "type": "number" },
        "confirmedAt": { "type": "string" }
      },
      "required": ["txHash", "walletAddress", "type", "confirmedAt"]
    },
    "ReferralActivityEvent": {
      "title": "ReferralActivityEvent",
      "description": "Email-like notification log for referral registrations and hash speed boosts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerAddress": { "type": "string" },
        "refereeAddress": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "speedIncreasePercent": { "type": "number" },
        "totalBoostPercent": { "type": "number" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "referrerAddress", "refereeAddress", "type", "subject"]
    }
  },
  "firestore": {
    "/users/{walletAddress}": {
      "schema": "UserProfile",
      "description": "Stores user mining profiles keyed by on-chain BEP-20 wallet address"
    },
    "/transactions/{transactionId}": {
      "schema": "TransactionRecord",
      "description": "Stores transaction receipts with BscScan hashes and miner wallet address"
    },
    "/usedTxHashes/{txHash}": {
      "schema": "UsedTxHash",
      "description": "Stores processed transaction hashes preventing replay attacks across all payments"
    },
    "/referralEvents/{eventId}": {
      "schema": "ReferralActivityEvent",
      "description": "Stores referral speed boost event logs and inbox notifications"
    }
  }
}
