{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User mining profile, tier progress, and verification status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "walletAddress": { "type": "string" },
        "currentTier": { "type": "number" },
        "totalPoints": { "type": "number" },
        "miningBalanceBNB": { "type": "number" },
        "lastClaimDate": { "type": "string" },
        "withdrawalStatus": { "type": "string" },
        "treasuryWalletAddress": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "loginStreak": { "type": "number" },
        "lastStreakClaimDate": { "type": "string" },
        "totalStreakPointsClaimed": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "currentTier", "totalPoints"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "On-chain tier upgrade or withdrawal fee transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string" },
        "amountBNB": { "type": "number" },
        "amountUSD": { "type": "number" },
        "txHash": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "amountUSD", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user mining profiles by email or wallet address"
    },
    "/transactions/{transactionId}": {
      "schema": "TransactionRecord",
      "description": "Stores transaction receipts with BscScan hashes"
    }
  }
}
